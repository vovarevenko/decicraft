{
  // Static site: Vite builds into dist/, Workers Static Assets serve it.
  // dist/_headers (copied from public/) sets the COOP/COEP headers that
  // SharedArrayBuffer needs, so the game runs cross-origin isolated.
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "decicraft",
  "compatibility_date": "2025-09-27",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
